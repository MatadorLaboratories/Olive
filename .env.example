# =====================================================================
# Olive Linen — environment variables
# Copy to `.env.local` for development. Never commit `.env.local`.
# =====================================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Olive Linen"

# --- Supabase ---
# Create at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Use sandbox / test keys for local development.
# https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# For local development, use the signing secret printed by `stripe listen`.
# For production, use the webhook endpoint secret from the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="Olive Linen <hello@olivelinen.co.nz>"
RESEND_AUDIENCE_ID=

# --- Instagram (server-side fetch) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- Scheduled reminders ---
CRON_SECRET=

# --- Admin bootstrap ---
# Bootstrap admin is tracked in `supabase/migrations/0004_bootstrap_admin_email.sql`.
# Update that migration (or add a new one) if the first admin email changes.
